---
import '../styles/global.css';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  /** true: la página ocupa exactamente el alto de la ventana (explorador). */
  fullscreen?: boolean;
  /** header transparente sobre hero (scroll aplica vidrio) */
  transparentHeader?: boolean;
}
const { title, fullscreen = false, transparentHeader = false } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Itzamná identifies regions on Earth with characteristics comparable to environments on the Moon and Mars through geospatial analysis and scientific criteria."
    />
    <link rel="icon" type="image/svg+xml" href="/logo-itzamna.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title} · Itzamná</title>
  </head>
  <body class:list={[
    'min-h-dvh flex flex-col',
    fullscreen ? 'h-dvh overflow-hidden' : '',
  ]}>
    <Header transparent={transparentHeader} />
    <slot />
    <div id="safety-gate" class="safety-gate" role="dialog" aria-modal="true" aria-labelledby="safety-gate-title" aria-describedby="safety-gate-text" style="position:fixed;inset:0;z-index:2147483647;display:flex;align-items:center;justify-content:center;padding:1.25rem;background:rgba(4,8,22,.88);">
      <div class="safety-gate-card" style="width:min(720px,96vw);border:1px solid rgba(120,190,255,.25);border-radius:1.1rem;background:rgba(10,20,40,.98);color:#eaf2ff;padding:1.5rem 1.6rem;box-shadow:0 30px 80px rgba(0,0,0,.55);">
        <h2 id="safety-gate-title" class="safety-gate-title" data-i18n="safety.title" style="margin:0 0 .85rem;font-size:1.15rem;letter-spacing:.02em;">SAFETY AND PRIVATE PROPERTY NOTICE</h2>
        <p id="safety-gate-text" class="safety-gate-text" style="margin:0 0 1.25rem;line-height:1.7;font-size:.98rem;color:#c8d8f0;">
          <span data-i18n="safety.text1">By continuing, you agree that you must respect local laws and private property boundaries.</span>
          <br /><br />
          <span data-i18n="safety.text2">Entering land, homes, or enclosed spaces to interact with game elements is strictly prohibited. The developer is not responsible for legal penalties, accidents, or damages resulting from unauthorized access to any property.</span>
        </p>
        <button id="safety-gate-accept" type="button" class="btn-primary safety-gate-btn" data-i18n="safety.accept" style="width:100%;padding:.9rem 1rem;border-radius:.8rem;border:1px solid rgba(120,190,255,.35);background:#2563eb;color:#fff;font-weight:600;cursor:pointer;">I accept and understand</button>
      </div>
    </div>
    <script is:inline>
      (function () {
        var gate = document.getElementById('safety-gate');
        var btn = document.getElementById('safety-gate-accept');
        if (!gate || !btn) return;
        var key = 'itzamna-safety-accepted';
        var accepted = false;
        try {
          accepted = sessionStorage.getItem(key) === '1' || localStorage.getItem(key) === '1';
        } catch (e) {}
        function show() {
          document.body.style.overflow = 'hidden';
          gate.hidden = false;
          gate.setAttribute('aria-hidden', 'false');
          gate.style.display = 'flex';
        }
        function hide() {
          gate.hidden = true;
          gate.setAttribute('aria-hidden', 'true');
          gate.style.display = 'none';
          document.body.style.overflow = '';
          try {
            sessionStorage.setItem(key, '1');
            localStorage.setItem(key, '1');
          } catch (e) {}
        }
        if (accepted) {
          hide();
          return;
        }
        show();
        btn.addEventListener('click', hide);
      })();
    </script>
    <script>
      import '../scripts/i18nInit';
    </script>
  </body>
</html>
