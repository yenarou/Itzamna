---
import '../styles/global.css';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  /** true: la página ocupa exactamente el alto de la ventana (explorador). */
  fullscreen?: boolean;
  /** header transparente sobre hero (scroll aplica vidrio) */
  transparentHeader?: boolean;
}
const { title, fullscreen = false, transparentHeader = false } = Astro.props;
---

<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Itzamná identifica zonas de la Tierra con características comparables a zonas de la Luna y Marte mediante análisis geoespacial y criterios científicos."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title} · Itzamná</title>
  </head>
  <body class:list={[
    'min-h-dvh flex flex-col',
    fullscreen ? 'h-dvh overflow-hidden' : '',
  ]}>
    <Header transparent={transparentHeader} />
    <slot />
    <div id="safety-gate" class="safety-gate" role="dialog" aria-modal="true" aria-labelledby="safety-gate-title" aria-describedby="safety-gate-text">
      <div class="safety-gate-card">
        <h2 id="safety-gate-title" class="safety-gate-title">AVISO DE SEGURIDAD Y PROPIEDAD PRIVADA</h2>
        <p id="safety-gate-text" class="safety-gate-text">
          Al continuar, aceptas que debes respetar las leyes locales y los límites de propiedad privada.
          <br /><br />
          Queda estrictamente prohibido invadir terrenos, viviendas o espacios cerrados para interactuar con elementos del juego. El desarrollador no se hace responsable por sanciones legales, accidentes o daños derivados del acceso no autorizado a cualquier inmueble.
        </p>
        <button id="safety-gate-accept" type="button" class="btn-primary safety-gate-btn">Acepto y entiendo</button>
      </div>
    </div>
    <script is:inline>
      (() => {
        const key = 'itzamna-safety-accepted';
        const gate = document.getElementById('safety-gate');
        const btn = document.getElementById('safety-gate-accept');
        if (!gate || !btn) return;
        const accepted = (() => { try { return localStorage.getItem(key) === '1'; } catch { return false; } })();
        if (accepted) {
          gate.hidden = true;
          gate.setAttribute('aria-hidden', 'true');
          return;
        }
        document.body.style.overflow = 'hidden';
        gate.hidden = false;
        gate.setAttribute('aria-hidden', 'false');
        btn.addEventListener('click', () => {
          try { localStorage.setItem(key, '1'); } catch {}
          gate.hidden = true;
          gate.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
        });
      })();
    </script>
  </body>
</html>
