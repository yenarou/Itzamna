---
import '../styles/global.css';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  /** true: the page occupies the full viewport height (explorer). */
  fullscreen?: boolean;
  /** Transparent header over the hero; scrolling applies the glass effect. */
  transparentHeader?: boolean;
}
const { title, fullscreen = false, transparentHeader = false } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Itzamná identifies regions on Earth with characteristics comparable to environments on the Moon and Mars through geospatial analysis and scientific criteria."
    />
    <link rel="icon" type="image/svg+xml" href="/logo-itzamna.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <title>{title} · Itzamná</title>

    <!-- Apply saved theme early to avoid flash/reload mismatch on navigation -->
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem('itzamna-theme');
          if (theme === 'light' || theme === 'dark') {
            document.documentElement.setAttribute('data-theme', theme);
          }
        } catch (e) {}
      })();
    </script>

    <!-- Safety notice: show once per page load/session entry, not on SPA view/tab switches -->
    <script is:inline>
      (function () {
        var KEY = 'itzamna-safety-accepted-session';
        var ok = false;
        try { ok = sessionStorage.getItem(KEY) === '1'; } catch (e) {}
        if (ok) document.documentElement.setAttribute('data-safety', 'accepted');
      })();
    </script>
  </head>
  <body class:list={[
    'min-h-dvh flex flex-col',
    fullscreen ? 'h-dvh overflow-hidden' : '',
  ]}>
    <Header transparent={transparentHeader} />
    <slot />
    <div id="safety-gate" class="safety-gate" role="dialog" aria-modal="true" aria-labelledby="safety-gate-title" aria-describedby="safety-gate-text">
      <div class="safety-gate-card">
        <h2 id="safety-gate-title" class="safety-gate-title" data-i18n="safety.title">SAFETY AND PRIVATE PROPERTY NOTICE</h2>
        <p id="safety-gate-text" class="safety-gate-text">
          <span data-i18n="safety.text1">By continuing, you agree that you must respect local laws and private property boundaries.</span>
          <br /><br />
          <span data-i18n="safety.text2">Entering land, homes, or enclosed spaces to interact with game elements is strictly prohibited. The developer is not responsible for legal penalties, accidents, or damages resulting from unauthorized access to any property.</span>
        </p>
        <button id="safety-gate-accept" type="button" class="btn-primary safety-gate-btn" data-i18n="safety.accept">I accept and understand</button>
      </div>
    </div>
    <script is:inline>
      (() => {
        const KEY = 'itzamna-safety-accepted-session';
        const root = document.documentElement;
        const gate = document.getElementById('safety-gate');
        const btn = document.getElementById('safety-gate-accept');
        if (!gate || !btn) return;
        if (root.getAttribute('data-safety') === 'accepted') {
          gate.hidden = true;
          gate.setAttribute('aria-hidden', 'true');
          return;
        }
        document.body.style.overflow = 'hidden';
        gate.hidden = false;
        gate.setAttribute('aria-hidden', 'false');
        btn.addEventListener('click', () => {
          try { sessionStorage.setItem(KEY, '1'); } catch {}
          root.setAttribute('data-safety', 'accepted');
          gate.hidden = true;
          gate.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
        });
      })();
    </script>
    <script>
      import '../scripts/i18nInit';
    </script>
  </body>
</html>