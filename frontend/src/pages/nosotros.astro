---
import Base from '../layouts/Base.astro';

const tech = [
  { name: 'Astro', roleEn: 'Frontend and fast page generation.', roleEs: 'Frontend and fast page generation.', key: 'about.tech.astro' },
  { name: 'TypeScript', roleEn: 'Typing and client-side logic.', roleEs: 'Typing and client-side logic.', key: 'about.tech.ts' },
  { name: 'Tailwind CSS', roleEn: 'Styling and responsive design.', roleEs: 'Styling and responsive design.', key: 'about.tech.tw' },
  { name: 'ASP.NET Core', roleEn: 'API/backend that orchestrates queries.', roleEs: 'API/backend that orchestrates queries.', key: 'about.tech.dotnet' },
  { name: 'Python', roleEn: 'Processing and computation in the scientific engine.', roleEs: 'Processing and computation in the scientific engine.', key: 'about.tech.py' },
  { name: 'FastAPI', roleEn: 'Scientific service for analog search and analysis.', roleEs: 'Scientific service for analog search and analysis.', key: 'about.tech.fastapi' },
];
---

<Base title="About">
  <main class="story-page">
    <section class="story-hero">
      <div class="story-hero-inner">
        <p class="zigzag-kicker" data-i18n="about.kicker">Project</p>
        <h1 data-i18n="about.h1">About Itzamná</h1>
        <p data-i18n="about.lead">Itzamná (Integrated Terrestrial-Zonal Analog &amp; Multi-factor Nearest Atlas) is a platform to identify and compare regions on Earth with characteristics comparable to environments on the Moon and Mars, supported by geospatial analysis and scientific criteria.</p>
        <nav class="section-nav" aria-label="Page sections">
          <a href="#introduccion" data-i18n="about.nav.intro">Introduction</a>
          <a href="#problema" data-i18n="about.nav.problem">Problem</a>
          <a href="#mision" data-i18n="about.nav.mission">Mission</a>
          <a href="#vision" data-i18n="about.nav.vision">Vision</a>
          <a href="#valores" data-i18n="about.nav.values">Values</a>
          <a href="#tecnologias" data-i18n="about.nav.tech">Technologies</a>
          <a href="#objetivos" data-i18n="about.nav.goals">Goals</a>
        </nav>
      </div>
    </section>

    <section id="introduccion" class="zigzag">
      <div class="zigzag-inner">
        <div class="zigzag-media reveal">
          <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcR2xJssqJoadkUVP41eHEsk-YdDo-SKDQaCo573dEI1e2dhvCjXG-lGi8g&s=10" alt="Earth from space" data-i18n-aria="content.img1.alt" loading="lazy" decoding="async" />
        </div>
        <div class="zigzag-copy reveal">
          <p class="zigzag-kicker" data-i18n="about.s1.kicker">Introduction</p>
          <h2 data-i18n="about.s1.h2">An atlas of analogs between Earth and other worlds</h2>
          <p data-i18n="about.s1.p1">Itzamná brings together, in a single experience, selecting a point on Earth, a search radius, and characteristics of interest to find analog candidates for lunar or Martian zones.</p>
          <p data-i18n="about.s1.p2">Its goal is to facilitate comparison between terrestrial landscapes and planetary environments through a clear interface and results with supporting information.</p>
        </div>
      </div>
    </section>

    <section id="problema" class="zigzag zigzag-alt">
      <div class="zigzag-inner reverse">
        <div class="zigzag-media reveal">
          <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcS462KLzatNx-vvUQAuTD_LeQ0ScKxHf9jnIonb99i3WQ&s=10" alt="Martian terrain from orbit" data-i18n-aria="about.img2.alt" loading="lazy" decoding="async" />
        </div>
        <div class="zigzag-copy reveal">
          <p class="zigzag-kicker" data-i18n="about.s2.kicker">Context</p>
          <h2 data-i18n="about.s2.h2">What problem it aims to address</h2>
          <p data-i18n="about.s2.p1">Studying environments similar to the Moon or Mars often requires identifying places on Earth that share relevant traits. That search can be fragmented and hard to compare when geographic, environmental, and similarity information is not integrated.</p>
          <p data-i18n="about.s2.p2">Itzamná addresses this need by offering a way to explore candidates in a defined area and visualize, in a unified way, their location, similarity, and associated descriptive fields.</p>
        </div>
      </div>
    </section>

    <section id="mision" class="story-section">
      <div class="story-section-inner story-grid two">
        <div class="reveal">
          <p class="zigzag-kicker" data-i18n="about.mission.kicker">Mission</p>
          <h2 class="font-display text-3xl font-semibold tracking-tight md:text-4xl" data-i18n="about.mission.h2">Make Earth and other worlds comparable</h2>
          <p class="mt-4 text-lg leading-8 text-mist max-w-[65ch]" data-i18n="about.mission.p">Facilitate the identification and understanding of terrestrial regions analogous to environments on the Moon and Mars, presenting geospatial information and similarity criteria clearly and usefully for learning and exploration.</p>
        </div>
        <div class="story-card reveal">
          <h3 data-i18n="about.mission.card.h3">In practice</h3>
          <ul class="mt-2 list-disc pl-5">
            <li data-i18n="about.mission.li1">Allow selection of location, radius, and characteristics of interest.</li>
            <li data-i18n="about.mission.li2">Calculate and display comparable candidates in the indicated area.</li>
            <li data-i18n="about.mission.li3">Communicate similarity and fields with traceability when they come from external sources or local estimates.</li>
          </ul>
        </div>
      </div>
    </section>

    <section id="vision" class="zigzag zigzag-alt">
      <div class="zigzag-inner">
        <div class="zigzag-media reveal">
          <img src="https://images-assets.nasa.gov/image/PIA00256/PIA00256~orig.jpg" alt="Lunar surface with craters" data-i18n-aria="content.img3.alt" loading="lazy" decoding="async" />
        </div>
        <div class="zigzag-copy reveal">
          <p class="zigzag-kicker" data-i18n="about.vision.kicker">Vision</p>
          <h2 data-i18n="about.vision.h2">A clear reference for planetary comparison</h2>
          <p data-i18n="about.vision.p">We aspire for Itzamná to evolve as an increasingly precise and transparent tool for exploring terrestrial analogs, progressively integrating better data and documented criteria that support educational and exploratory planning contexts.</p>
        </div>
      </div>
    </section>

    <section id="valores" class="story-section">
      <div class="story-section-inner">
        <p class="zigzag-kicker" data-i18n="about.values.kicker">Values</p>
        <h2 class="font-display text-3xl font-semibold tracking-tight md:text-4xl mb-6" data-i18n="about.values.h2">Project principles</h2>
        <div class="story-grid" style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));">
          <div class="story-card reveal"><h3 data-i18n="about.v1.t">Scientific clarity</h3><p data-i18n="about.v1.d">Distinguish queried data, estimates, and calculated results.</p></div>
          <div class="story-card reveal"><h3 data-i18n="about.v2.t">Usefulness</h3><p data-i18n="about.v2.d">Present understandable comparisons for exploration and learning.</p></div>
          <div class="story-card reveal"><h3 data-i18n="about.v3.t">Progressive rigor</h3><p data-i18n="about.v3.d">Improve criteria and sources in a verifiable, documented way.</p></div>
          <div class="story-card reveal"><h3 data-i18n="about.v4.t">Accessibility</h3><p data-i18n="about.v4.d">Make geospatial information easier to explore and understand.</p></div>
        </div>
      </div>
    </section>


    <section id="tecnologias" class="zigzag">
      <div class="zigzag-inner reverse">
        <div class="zigzag-media reveal">
          <img src="https://images-assets.nasa.gov/image/PIA12235/PIA12235~orig.jpg" alt="Topographic visualization and geospatial data" data-i18n-aria="content.img4.alt" loading="lazy" decoding="async" />
        </div>
        <div class="zigzag-copy reveal">
          <p class="zigzag-kicker" data-i18n="about.tech.kicker">Technologies</p>
          <h2 data-i18n="about.tech.h2">Project stack</h2>
          <p data-i18n="about.tech.p">Technologies currently used and their responsibility within Itzamná:</p>
          <ul>
            <li data-i18n-html="about.tech.li1"><strong>Astro:</strong> Frontend and fast page generation.</li>
            <li data-i18n-html="about.tech.li2"><strong>TypeScript:</strong> Typing and client-side logic.</li>
            <li data-i18n-html="about.tech.li3"><strong>Tailwind CSS:</strong> Styling and responsive design.</li>
            <li data-i18n-html="about.tech.li4"><strong>ASP.NET Core:</strong> API/backend that orchestrates queries.</li>
            <li data-i18n-html="about.tech.li5"><strong>Python:</strong> Processing and computation in the scientific engine.</li>
            <li data-i18n-html="about.tech.li6"><strong>FastAPI:</strong> Scientific service for analog search and analysis.</li>
          </ul>
        </div>
      </div>
    </section>

    <section id="objetivos" class="story-section">
      <div class="story-section-inner">
        <div class="story-card reveal" style="padding:1.75rem;">
          <p class="zigzag-kicker" data-i18n="about.goals.kicker">Goals and evolution</p>
          <h2 class="font-display text-3xl font-semibold tracking-tight mb-3" data-i18n="about.goals.h2">Continuous and verifiable improvement</h2>
          <p class="text-mist leading-8 max-w-[70ch]" data-i18n="about.goals.p">The project seeks to gradually improve data quality, comparison criteria, and the exploration experience, prioritizing transparency about the origin of information (external sources, calculations, or estimates) and maintaining existing capabilities while incorporating documented improvements.</p>
        </div>
      </div>
    </section>
  </main>

  <script>
    const els = document.querySelectorAll('.reveal');
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); } });
      }, { threshold: 0.12 });
      els.forEach((el) => { if (!el.classList.contains('is-visible')) io.observe(el); });
    } else {
      els.forEach((el) => el.classList.add('is-visible'));
    }
  </script>
</Base>
