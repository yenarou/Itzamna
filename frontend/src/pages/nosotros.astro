---
import Base from '../layouts/Base.astro';

const tech = [
  { name: 'Astro', role: 'Frontend y generación de páginas rápidas.' },
  { name: 'TypeScript', role: 'Tipado y lógica en el cliente.' },
  { name: 'Tailwind CSS', role: 'Estilos y diseño responsive.' },
  { name: 'ASP.NET Core', role: 'API/backend que orquesta las consultas.' },
  { name: 'Python', role: 'Procesamiento y cálculo en el motor científico.' },
  { name: 'FastAPI', role: 'Servicio científico para búsqueda y análisis de análogos.' },
];

const valores = [
  { t: 'Claridad científica', d: 'Distinguir datos consultados, estimaciones y resultados calculados.' },
  { t: 'Utilidad', d: 'Presentar comparaciones comprensibles para exploración y aprendizaje.' },
  { t: 'Rigor progresivo', d: 'Mejorar criterios y fuentes de forma verificable y documentada.' },
  { t: 'Accesibilidad', d: 'Hacer la información geoespacial más fácil de explorar y entender.' },
];
---

<Base title="Nosotros">
  <main class="story-page">
    <section class="story-hero">
      <div class="story-hero-inner">
        <p class="zigzag-kicker">Proyecto</p>
        <h1>Sobre Itzamná</h1>
        <p>
          Itzamná (Integrated Terrestrial-Zonal Analog &amp; Multi-factor Nearest Atlas) es una plataforma para identificar y comparar regiones de la Tierra con características comparables a entornos de la Luna y Marte, apoyándose en análisis geoespacial y criterios científicos.
        </p>
        <nav class="section-nav" aria-label="Secciones de esta página">
          <a href="#introduccion">Introducción</a>
          <a href="#problema">Problema</a>
          <a href="#mision">Misión</a>
          <a href="#vision">Visión</a>
          <a href="#valores">Valores</a>
          <a href="#equipo">Equipo</a>
          <a href="#tecnologias">Tecnologías</a>
          <a href="#objetivos">Objetivos</a>
        </nav>
      </div>
    </section>

    <section id="introduccion" class="zigzag">
      <div class="zigzag-inner">
        <div class="zigzag-media reveal">
          <img src="https://images-assets.nasa.gov/image/PIA18033/PIA18033~orig.jpg" alt="La Tierra desde el espacio" loading="lazy" decoding="async" />
        </div>
        <div class="zigzag-copy reveal">
          <p class="zigzag-kicker">Introducción</p>
          <h2>Un atlas de análogos entre la Tierra y otros mundos</h2>
          <p>
            Itzamná reúne en una misma experiencia la selección de un punto en la Tierra, un radio de búsqueda y características de interés para encontrar candidatos análogos a zonas lunares o marcianas.
          </p>
          <p>
            Su objetivo es facilitar la comparación entre paisajes terrestres y entornos planetarios mediante una interfaz clara y resultados con información de apoyo.
          </p>
        </div>
      </div>
    </section>

    <section id="problema" class="zigzag zigzag-alt">
      <div class="zigzag-inner reverse">
        <div class="zigzag-media reveal">
          <img src="https://images-assets.nasa.gov/image/PIA00407/PIA00407~orig.jpg" alt="Terreno marciano visto desde órbita" loading="lazy" decoding="async" />
        </div>
        <div class="zigzag-copy reveal">
          <p class="zigzag-kicker">Contexto</p>
          <h2>Qué problema busca abordar</h2>
          <p>
            Estudiar entornos similares a la Luna o Marte suele requerir identificar lugares en la Tierra que compartan rasgos relevantes. Esa búsqueda puede ser dispersa y difícil de comparar cuando la información geográfica, ambiental y de similitud no está integrada.
          </p>
          <p>
            Itzamná aborda esta necesidad ofreciendo una forma de explorar candidatos en un área definida y visualizar, de manera unificada, su ubicación, similitud y campos descriptivos asociados.
          </p>
        </div>
      </div>
    </section>

    <section id="mision" class="story-section">
      <div class="story-section-inner story-grid two">
        <div class="reveal">
          <p class="zigzag-kicker">Misión</p>
          <h2 class="font-display text-3xl font-semibold tracking-tight md:text-4xl">Hacer comparables la Tierra y otros mundos</h2>
          <p class="mt-4 text-lg leading-8 text-mist max-w-[65ch]">
            Facilitar la identificación y comprensión de regiones terrestres análogas a entornos de la Luna y Marte, presentando información geoespacial y criterios de similitud de forma clara y útil para el aprendizaje y la exploración.
          </p>
        </div>
        <div class="story-card reveal">
          <h3>En la práctica</h3>
          <ul class="mt-2 list-disc pl-5">
            <li>Permitir seleccionar ubicación, radio y características de interés.</li>
            <li>Calcular y mostrar candidatos comparables en el área indicada.</li>
            <li>Comunicar similitud y campos con trazabilidad cuando provienen de fuentes externas o de estimaciones locales.</li>
          </ul>
        </div>
      </div>
    </section>

    <section id="vision" class="zigzag zigzag-alt">
      <div class="zigzag-inner">
        <div class="zigzag-media reveal">
          <img src="https://images-assets.nasa.gov/image/PIA00256/PIA00256~orig.jpg" alt="Superficie lunar con cráteres" loading="lazy" decoding="async" />
        </div>
        <div class="zigzag-copy reveal">
          <p class="zigzag-kicker">Visión</p>
          <h2>Una referencia clara para la comparación planetaria</h2>
          <p>
            Aspiramos a que Itzamná evolucione como una herramienta cada vez más precisa y transparente para explorar análogos terrestres, integrando progresivamente mejores datos y criterios documentados que apoyen contextos educativos y de planificación exploratoria.
          </p>
        </div>
      </div>
    </section>

    <section id="valores" class="story-section">
      <div class="story-section-inner">
        <p class="zigzag-kicker">Valores</p>
        <h2 class="font-display text-3xl font-semibold tracking-tight md:text-4xl mb-6">Principios del proyecto</h2>
        <div class="story-grid" style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));">
          {valores.map((v) => (
            <div class="story-card reveal">
              <h3>{v.t}</h3>
              <p>{v.d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="equipo" class="story-section zigzag-alt">
      <div class="story-section-inner">
        <p class="zigzag-kicker">Equipo</p>
        <h2 class="font-display text-3xl font-semibold tracking-tight md:text-4xl mb-2">Equipo de desarrollo</h2>
        <p class="muted mb-6 max-w-[65ch]">Espacio preparado para documentar a las personas que contribuyen al proyecto. (Sin nombres, fotografías ni cargos inventados.)</p>
        <div class="team-grid">
          {[1,2,3].map((i) => (
            <div class="team-placeholder reveal" aria-label="Integrante por documentar">
              <div class="team-avatar" aria-hidden="true"></div>
              <strong>Integrante {i}</strong>
              <span class="muted text-sm">Nombre por agregar</span>
              <span class="muted text-sm">Rol / contribución por documentar</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="tecnologias" class="zigzag">
      <div class="zigzag-inner reverse">
        <div class="zigzag-media reveal">
          <img src="https://images-assets.nasa.gov/image/PIA12235/PIA12235~orig.jpg" alt="Visualización topográfica y datos geoespaciales" loading="lazy" decoding="async" />
        </div>
        <div class="zigzag-copy reveal">
          <p class="zigzag-kicker">Tecnologías</p>
          <h2>Stack del proyecto</h2>
          <p>Tecnologías utilizadas actualmente y su responsabilidad dentro de Itzamná:</p>
          <ul>
            {tech.map((t) => (
              <li><strong>{t.name}:</strong> {t.role}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section id="objetivos" class="story-section">
      <div class="story-section-inner">
        <div class="story-card reveal" style="padding:1.75rem;">
          <p class="zigzag-kicker">Objetivos y evolución</p>
          <h2 class="font-display text-3xl font-semibold tracking-tight mb-3">Mejora continua y verificable</h2>
          <p class="text-mist leading-8 max-w-[70ch]">
            El proyecto busca mejorar de forma gradual la calidad de los datos, los criterios de comparación y la experiencia de exploración, priorizando transparencia sobre el origen de la información (fuentes externas, cálculos o estimaciones) y manteniendo las capacidades existentes mientras se incorporan mejoras documentadas.
          </p>
        </div>
      </div>
    </section>
  </main>

  <script>
    const els = document.querySelectorAll('.reveal');
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); } });
      }, { threshold: 0.12 });
      els.forEach((el) => { if (!el.classList.contains('is-visible')) io.observe(el); });
    } else {
      els.forEach((el) => el.classList.add('is-visible'));
    }
  </script>
</Base>
