---
import Base from '../layouts/Base.astro';
import InfoMosaic from '../components/InfoMosaic.astro';
---

<Base title="Nosotros">
  <InfoMosaic
    topLabel={{
      heading: 'Nosotros',
      paragraphs: ['Creamos herramientas para pensar la Tierra y el espacio como un mismo sistema de paisaje, clima y ciencia.'],
    }}
    topInfo={{
      heading: 'Qué es Itzamná',
      paragraphs: [
        'Itzamná es una plataforma que conecta observación terrestre y exploración planetaria para encontrar analogías útiles entre lugares de nuestro planeta y zonas de la Luna y Marte.',
        'El nombre proviene de la tradición maya, donde el conocimiento y el cielo estaban profundamente ligados. Esa idea nos guía: mirar el planeta y el espacio con la misma curiosidad.',
      ],
    }}
    bottomInfo={{
      heading: 'Cómo trabajamos',
      paragraphs: [
        'Combinamos análisis geográfico, comparación de rasgos ambientales y visualización clara para mostrar qué lugares de la Tierra se parecen más a ciertos escenarios extraterrestres.',
        'Nuestra visión es hacer accesible ese tipo de conocimiento para que pueda servir tanto a la educación como a la planificación de futuras exploraciones.',
      ],
    }}
    bottomLabel={{
      heading: 'Misión',
      paragraphs: [
        'Hacer que la comparación entre la Tierra y otros mundos sea intuitiva, útil y inspiradora para aprender, investigar y imaginar el futuro.',
      ],
    }}
  />
</Base>
