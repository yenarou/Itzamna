---
import Base from '../layouts/Base.astro';
import InfoMosaic from '../components/InfoMosaic.astro';
---

<Base title="Visión">
  <InfoMosaic
    topLabel={{
      heading: 'Visión',
      paragraphs: ['Crear una forma clara, bella y útil de entender cómo la Tierra puede servir como laboratorio de otros mundos.'],
    }}
    topInfo={{
      heading: 'Un atlas de analogías para la exploración',
      paragraphs: [
        'Itzamná busca reunir en una sola mirada los paisajes terrestres que más se parecen a los entornos lunares y marcianos.',
        'La idea es que la observación deje de ser fragmentada y pase a convertirse en una herramienta para diseñar misiones, entrenar equipos y comparar terrenos con criterio científico.',
      ],
    }}
    bottomInfo={{
      heading: 'Pensado para aprender y diseñar',
      paragraphs: [
        'Cada comparación se presenta con un lenguaje cercano para estudiantes, investigadores y equipos de campo. La intención es facilitar la exploración, pero también la reflexión: qué condiciones de la Tierra son más parecidas a las que esperan encontrar en la Luna o en Marte.',
      ],
    }}
    bottomLabel={{
      heading: 'Público',
      paragraphs: [
        'Investigadores, docentes, estudiantes y curiosos del espacio que quieran entender mejor cómo se comparan nuestros paisajes con los planetas vecinos.',
      ],
    }}
  />
</Base>
