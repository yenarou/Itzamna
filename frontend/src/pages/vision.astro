---
import Base from '../layouts/Base.astro';
---

<Base title="Vision">
  <main class="story-page">
    <section class="story-hero">
      <div class="story-hero-inner reveal is-visible">
        <p class="zigzag-kicker" data-i18n="vision.kicker">Vision</p>
        <h1 data-i18n="vision.h1">A clear way to understand Earth as a laboratory for other worlds</h1>
        <p data-i18n="vision.lead">Itzamná aims to bring together, in a single view, the terrestrial landscapes that most closely resemble lunar and Martian environments, to facilitate comparison, learning, and analysis.</p>
      </div>
    </section>

    <section class="zigzag">
      <div class="zigzag-inner">
        <div class="zigzag-media reveal">
          <img src="https://images-assets.nasa.gov/image/PIA03654/PIA03654~orig.jpg" alt="Rocky landscape evoking planetary exploration terrain" data-i18n-aria="vision.img1.alt" loading="lazy" decoding="async" />
        </div>
        <div class="zigzag-copy reveal">
          <p class="zigzag-kicker" data-i18n="vision.s1.kicker">Analog atlas</p>
          <h2 data-i18n="vision.s1.h2">An atlas of analogs for exploration</h2>
          <p data-i18n="vision.s1.p">The proposal is for observation to move from fragmented to a tool for comparing terrains and contexts with scientific criteria, supporting activities such as scenario study and analysis preparation.</p>
        </div>
      </div>
    </section>

    <section class="zigzag zigzag-alt">
      <div class="zigzag-inner reverse">
        <div class="zigzag-media reveal">
          <img src="https://www.universetoday.com/article_images/Moon_and_Mars_1069898275777-e1706553049885.png" alt="Topographic and geospatial representation" data-i18n-aria="vision.img2.alt" loading="lazy" decoding="async" />
        </div>
        <div class="zigzag-copy reveal">
          <p class="zigzag-kicker" data-i18n="vision.s2.kicker">Learn and design</p>
          <h2 data-i18n="vision.s2.h2">Designed to learn and compare</h2>
          <p data-i18n="vision.s2.p">Each comparison is presented in accessible language for students, researchers, and teams interested in understanding which conditions on Earth are most similar to those expected on the Moon or Mars, while keeping the origin of data and estimates visible.</p>
        </div>
      </div>
    </section>

    <section class="story-section">
      <div class="story-section-inner">
        <div class="story-grid two">
          <div class="story-card reveal">
            <p class="zigzag-kicker" data-i18n="vision.c1.kicker">Audience</p>
            <h3 class="font-display text-2xl mt-1" data-i18n="vision.c1.h3">Who can it serve?</h3>
            <p class="mt-3" data-i18n="vision.c1.p">Researchers, educators, students, and people interested in space who want to explore comparisons between terrestrial landscapes and lunar or Martian environments.</p>
          </div>
          <div class="story-card reveal">
            <p class="zigzag-kicker" data-i18n="vision.c2.kicker">Approach</p>
            <h3 class="font-display text-2xl mt-1" data-i18n="vision.c2.h3">Clarity and traceability</h3>
            <p class="mt-3" data-i18n="vision.c2.p">The vision prioritizes a comprehensible experience, where similarity and displayed fields make it possible to distinguish between queried, calculated, and estimated information when applicable.</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script>
    const els = document.querySelectorAll('.reveal');
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); } });
      }, { threshold: 0.12 });
      els.forEach((el) => { if (!el.classList.contains('is-visible')) io.observe(el); });
    } else {
      els.forEach((el) => el.classList.add('is-visible'));
    }
  </script>
</Base>
