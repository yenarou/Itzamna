---
import Base from '../layouts/Base.astro';
---

<Base title="Visión">
  <main class="story-page">
    <section class="story-hero">
      <div class="story-hero-inner reveal is-visible">
        <p class="zigzag-kicker">Visión</p>
        <h1>Una forma clara de entender la Tierra como laboratorio de otros mundos</h1>
        <p>
          Itzamná busca reunir en una sola mirada los paisajes terrestres que más se parecen a entornos lunares y marcianos, para facilitar la comparación, el aprendizaje y el análisis.
        </p>
      </div>
    </section>

    <section class="zigzag">
      <div class="zigzag-inner">
        <div class="zigzag-media reveal">
          <img src="https://images-assets.nasa.gov/image/PIA03654/PIA03654~orig.jpg" alt="Paisaje rocoso que evoca terrenos de exploración planetaria" loading="lazy" decoding="async" />
        </div>
        <div class="zigzag-copy reveal">
          <p class="zigzag-kicker">Atlas de analogías</p>
          <h2>Un atlas de analogías para la exploración</h2>
          <p>
            La propuesta es que la observación deje de ser fragmentada y se convierta en una herramienta para comparar terrenos y contextos con criterios científicos, apoyando actividades como el estudio de escenarios y la preparación de análisis.
          </p>
        </div>
      </div>
    </section>

    <section class="zigzag zigzag-alt">
      <div class="zigzag-inner reverse">
        <div class="zigzag-media reveal">
          <img src="https://images-assets.nasa.gov/image/PIA12235/PIA12235~orig.jpg" alt="Representación topográfica y geoespacial" loading="lazy" decoding="async" />
        </div>
        <div class="zigzag-copy reveal">
          <p class="zigzag-kicker">Aprender y diseñar</p>
          <h2>Pensado para aprender y comparar</h2>
          <p>
            Cada comparación se presenta con un lenguaje cercano para estudiantes, investigadores y equipos interesados en entender qué condiciones de la Tierra son más parecidas a las que se esperan en la Luna o en Marte, manteniendo visible el origen de los datos y las estimaciones.
          </p>
        </div>
      </div>
    </section>

    <section class="story-section">
      <div class="story-section-inner">
        <div class="story-grid two">
          <div class="story-card reveal">
            <p class="zigzag-kicker">Público</p>
            <h3 class="font-display text-2xl mt-1">¿A quién puede servir?</h3>
            <p class="mt-3">Investigadores, docentes, estudiantes y personas interesadas en el espacio que quieran explorar comparaciones entre paisajes terrestres y entornos lunares o marcianos.</p>
          </div>
          <div class="story-card reveal">
            <p class="zigzag-kicker">Enfoque</p>
            <h3 class="font-display text-2xl mt-1">Claridad y trazabilidad</h3>
            <p class="mt-3">La visión prioriza una experiencia comprensible, donde la similitud y los campos mostrados permitan distinguir entre información consultada, calculada y estimada cuando aplica.</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script>
    const els = document.querySelectorAll('.reveal');
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); } });
      }, { threshold: 0.12 });
      els.forEach((el) => { if (!el.classList.contains('is-visible')) io.observe(el); });
    } else {
      els.forEach((el) => el.classList.add('is-visible'));
    }
  </script>
</Base>
