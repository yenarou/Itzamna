---
import Base from '../layouts/Base.astro';
import HomeView from '../components/home/HomeView.astro';
import ContentView from '../components/home/ContentView.astro';
import ExplorerView from '../components/explorer/ExplorerView.astro';
---

<Base title="Itzamná - Explore terrestrial analogs" transparentHeader={true}>
  <main id="app-views" class="app-view-root" data-view="home">
    <HomeView />
    <ContentView />
    <ExplorerView />
  </main>

  <script>
    import '../scripts/appViews';
  </script>
  <script>
    const loadReveal = () => import('../scripts/reveal');
    if ('requestIdleCallback' in window) {
      (window as any).requestIdleCallback(() => { void loadReveal(); }, { timeout: 2500 });
    } else {
      setTimeout(() => { void loadReveal(); }, 200);
    }
  </script>
  <script>
    // Lazy-load heavy explorer (globe.gl, map logic), Leaflet and explorer UI helpers only when needed.
    let explorerReady: Promise<void> | null = null;
    function loadLeaflet(): Promise<void> {
      if ((window as any).L) return Promise.resolve();
      if ((window as any).__leafletLoading) return (window as any).__leafletLoading;
      (window as any).__leafletLoading = new Promise<void>((resolve, reject) => {
        const link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
        link.integrity = 'sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=';
        link.crossOrigin = '';
        document.head.appendChild(link);
        const s = document.createElement('script');
        s.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
        s.integrity = 'sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=';
        s.crossOrigin = '';
        s.defer = true;
        s.onload = () => resolve();
        s.onerror = () => reject(new Error('Failed to load Leaflet'));
        document.head.appendChild(s);
      });
      return (window as any).__leafletLoading;
    }
    async function ensureExplorer() {
      if (!explorerReady) {
        explorerReady = (async () => {
          await loadLeaflet();
          await Promise.all([
            import('../scripts/customDropdowns'),
            import('../scripts/planetDropdown'),
            import('../scripts/explorer'),
          ]);
        })();
      }
      return explorerReady;
    }
    // Preload when user intends to explore
    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('[data-show-view="explore"]')) void ensureExplorer();
    }, { capture: true });
    // Also load if app switches to explore by other means
    window.addEventListener('itzamna:view', (e: Event) => {
      const name = (e as CustomEvent).detail?.view;
      if (name === 'explore') void ensureExplorer();
    });
    // Fallback: if explore view becomes visible
    const root = document.getElementById('app-views');
    if (root) {
      new MutationObserver(() => {
        if (root.dataset.view === 'explore') void ensureExplorer();
      }).observe(root, { attributes: true, attributeFilter: ['data-view'] });
    }
  </script>
</Base>
