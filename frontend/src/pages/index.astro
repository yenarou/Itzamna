---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Itzamná | Inicio">
  <main class="min-h-screen px-6 py-20">
    <div class="mx-auto max-w-5xl">
      <div class="rounded-2xl border border-slate-800 bg-slate-900/70 p-8 shadow-2xl shadow-slate-950/40 ring-1 ring-slate-800/70">
        <p class="mb-4 text-sm font-medium uppercase tracking-[0.3em] text-cyan-300">Itzamná</p>
        <h1 class="text-4xl font-bold tracking-tight text-white sm:text-5xl">Integrated Terrestrial-Zonal Analog &amp; Multi-factor Nearest Atlas</h1>
        <p class="mt-6 max-w-2xl text-lg text-slate-300">
          Estructura inicial del proyecto preparada para futuras etapas de análisis comparativo entre ubicaciones terrestres, lunares y marcianas.
        </p>

        <div class="mt-10 grid gap-4 md:grid-cols-3">
          <div class="rounded-xl border border-slate-700 bg-slate-950/60 p-4">
            <p class="text-sm text-slate-400">Frontend</p>
            <p class="mt-2 font-semibold text-cyan-300">Astro + TypeScript + Tailwind</p>
          </div>
          <div class="rounded-xl border border-slate-700 bg-slate-950/60 p-4">
            <p class="text-sm text-slate-400">Backend</p>
            <p class="mt-2 font-semibold text-violet-300">ASP.NET Core Web API</p>
          </div>
          <div class="rounded-xl border border-slate-700 bg-slate-950/60 p-4">
            <p class="text-sm text-slate-400">Motor científico</p>
            <p class="mt-2 font-semibold text-emerald-300">FastAPI</p>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>
