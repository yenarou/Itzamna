---
import Base from '../layouts/Base.astro';
import Planet from '../components/Planet.astro';
import { EARTH_FIELDS, PLANETS } from '../lib/data';

const paneTitle = 'font-display text-3xl font-medium';
const tech = [
  { name: 'Astro', desc: 'Framework del frontend para páginas rápidas y contenido estático optimizado.' },
  { name: 'TypeScript', desc: 'Tipado en el frontend y scripts para mayor claridad y mantenimiento.' },
  { name: 'Tailwind CSS', desc: 'Sistema de estilos utilitario para la interfaz y el diseño responsive.' },
  { name: 'ASP.NET Core', desc: 'Backend que expone y orquesta la API de búsqueda de análogos.' },
  { name: 'Python', desc: 'Lenguaje del motor científico para cálculo e integración de datos.' },
  { name: 'FastAPI', desc: 'Servicio científico que procesa consultas y devuelve candidatos/análisis.' },
];
---

<Base title="Explorar" transparentHeader>
  <main class="page-wrap">
    <!-- HERO -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-stars" aria-hidden="true"></div>
      <div class="hero-orbits" aria-hidden="true">
        <span class="hero-orbit o1"></span>
        <span class="hero-orbit o2"></span>
        <span class="hero-orbit o3"></span>
        <span class="hero-planet mars"></span>
        <span class="hero-planet moon"></span>
      </div>
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="hero-content reveal is-visible">
        <p class="hero-kicker">Exploración científica · Análogos terrestres</p>
        <h1 id="hero-title">Explorando la Tierra para comprender otros mundos.</h1>
        <p>
          Itzamná identifica regiones terrestres con características comparables a entornos de la Luna y Marte mediante análisis geoespacial y criterios científicos.
        </p>
        <div class="hero-actions">
          <a href="#explorador" class="btn-primary">Explorar Itzamná</a>
          <a href="/nosotros" class="btn-secondary">Conocer el proyecto</a>
        </div>
      </div>
    </section>

    <!-- ZIGZAG 1: ¿Qué es Itzamná? (imagen izq, texto der) -->
    <section class="zigzag" id="que-es">
      <div class="zigzag-inner">
        <div class="zigzag-media reveal">
          <img src="https://images-assets.nasa.gov/image/PIA18033/PIA18033~orig.jpg" alt="La Tierra vista desde el espacio, con océanos y continentes iluminados" loading="lazy" decoding="async" />
        </div>
        <div class="zigzag-copy reveal">
          <p class="zigzag-kicker">Plataforma</p>
          <h2>¿Qué es Itzamná?</h2>
          <p>
            <strong>Itzamná (Integrated Terrestrial-Zonal Analog &amp; Multi-factor Nearest Atlas)</strong> es una plataforma que ayuda a localizar y comparar regiones de la Tierra con rasgos similares a zonas de la Luna y Marte.
          </p>
          <p>
            A partir de un punto geográfico, un radio y características seleccionadas, calcula candidatos análogos y presenta información georreferenciada, similitud por criterios y datos de apoyo para la exploración y el análisis.
          </p>
        </div>
      </div>
    </section>

    <!-- ZIGZAG 2: Nuestro propósito (texto izq, imagen der) -->
    <section class="zigzag zigzag-alt" id="proposito">
      <div class="zigzag-inner reverse">
        <div class="zigzag-media reveal">
          <img src="https://images-assets.nasa.gov/image/PIA00407/PIA00407~orig.jpg" alt="Superficie de Marte con relieve y tonalidades rojizas" loading="lazy" decoding="async" />
        </div>
        <div class="zigzag-copy reveal">
          <p class="zigzag-kicker">Propósito</p>
          <h2>Nuestro propósito</h2>
          <p>
            Encontrar análogos terrestres permite estudiar, en nuestro propio planeta, condiciones y paisajes comparables a entornos extraterrestres. Esto facilita preparar observaciones, entrenamientos y análisis en lugares accesibles antes de pensar en escenarios lunares o marcianos.
          </p>
          <p>
            Itzamná busca hacer esa comparación más clara: reunir ubicación, contexto ambiental y criterios de similitud en una sola vista para apoyar la toma de decisiones y el aprendizaje.
          </p>
        </div>
      </div>
    </section>

    <!-- ZIGZAG 3: Exploración y análisis (imagen izq, texto der) -->
    <section class="zigzag" id="analisis">
      <div class="zigzag-inner">
        <div class="zigzag-media reveal">
          <img src="https://images-assets.nasa.gov/image/PIA00256/PIA00256~orig.jpg" alt="Superficie lunar con cráteres y mares basálticos" loading="lazy" decoding="async" />
        </div>
        <div class="zigzag-copy reveal">
          <p class="zigzag-kicker">Análisis geoespacial</p>
          <h2>Exploración y análisis</h2>
          <p>
            La plataforma permite seleccionar un planeta y una zona de interés, elegir un punto en el mapa y definir un radio de búsqueda. Con esos parámetros genera candidatos calculados en el área y muestra su similitud, distancia y correlación por campo.
          </p>
          <p>
            Los resultados combinan datos de consulta (cuando las fuentes responden) con estimaciones locales marcadas como tales, ofreciendo una lectura transparente entre datos obtenidos y valores calculados.
          </p>
        </div>
      </div>
    </section>

    <!-- ZIGZAG 4: Tecnología (texto izq, imagen der) -->
    <section class="zigzag zigzag-alt" id="tecnologia">
      <div class="zigzag-inner reverse">
        <div class="zigzag-media reveal">
          <img src="https://images-assets.nasa.gov/image/PIA12235/PIA12235~orig.jpg" alt="Mapa topográfico y relieve representando análisis de superficie" loading="lazy" decoding="async" />
        </div>
        <div class="zigzag-copy reveal">
          <p class="zigzag-kicker">Arquitectura</p>
          <h2>Tecnología</h2>
          <p>Itzamná integra componentes web y de cálculo científico, cada uno con una responsabilidad definida:</p>
          <ul>
            {tech.map((t) => (
              <li><strong>{t.name}:</strong> {t.desc}</li>
            ))}
          </ul>
          <div class="chip-row" aria-label="Tecnologías del proyecto">
            {tech.map((t) => <span class="chip">{t.name}</span>)}
          </div>
        </div>
      </div>
    </section>

    <!-- ZIGZAG 5: Visión a futuro (imagen izq, texto der) -->
    <section class="zigzag" id="vision-futuro">
      <div class="zigzag-inner">
        <div class="zigzag-media reveal">
          <img src="https://images-assets.nasa.gov/image/PIA03654/PIA03654~orig.jpg" alt="Concepto de exploración planetaria y terreno rocoso" loading="lazy" decoding="async" />
        </div>
        <div class="zigzag-copy reveal">
          <p class="zigzag-kicker">Evolución</p>
          <h2>Visión a futuro</h2>
          <p>
            La visión del proyecto es fortalecer la precisión y utilidad de las comparaciones, incorporando de forma progresiva mejores fuentes de datos y criterios de análisis documentados, para que la herramienta sea cada vez más útil en contextos educativos y de planificación exploratoria.
          </p>
          <p>
            Cualquier nueva capacidad se incorporará de manera gradual y verificable, manteniendo clara la distinción entre resultados calculados, estimaciones y datos provenientes de fuentes externas.
          </p>
        </div>
      </div>
    </section>

    <!-- EXPLORADOR (funcionalidad existente preservada) -->
    <section id="explorador" class="relative border-t border-line" aria-label="Explorador de análogos">
      <div class="mx-auto max-w-7xl px-4 pt-14 pb-4 md:px-8">
        <p class="zigzag-kicker">Herramienta</p>
        <h2 class="font-display text-3xl font-semibold tracking-tight md:text-4xl">Explorar análogos terrestres</h2>
        <p class="mt-3 max-w-2xl text-mist">Selecciona un planeta, define características y un punto en la Tierra para buscar zonas comparables.</p>
      </div>

      <div class="mx-auto max-w-[110rem] px-2 pb-6 md:px-4">
  <div
    id="explorer"
    data-state="idle"
    class="relative grid min-h-[88svh] grid-rows-2 overflow-hidden rounded-2xl md:grid-cols-2 md:grid-rows-1"
  >
    <!-- Tierra -->
    <section
      aria-labelledby="earth-title"
      class="flex flex-col items-center justify-center gap-5 bg-[#10303e] p-4"
    >
      <div id="earth-visual" class="flex flex-col items-center gap-3">
        <Planet body="tierra" />
        <div id="earth-compare-wrap" class="relative hidden">
          <img id="earth-compare" alt="" hidden referrerpolicy="no-referrer" class="aspect-video w-[min(34vmin,26rem)] rounded-lg border border-line object-cover shadow-2xl" />
          <span aria-hidden="true" class="pointer-events-none absolute left-1/2 top-1/2 z-10 -translate-x-1/2 -translate-y-full"><span class="block h-4 w-4 -rotate-45 rounded-full rounded-bl-none border-2 border-white bg-ochre shadow-lg"></span><span class="mx-auto -mt-0.5 block h-2 w-2 rounded-full bg-white/90 shadow"></span></span>
        </div>
        <p id="earth-compare-caption" hidden class="max-w-xs text-center text-sm text-mist"></p>
      </div>
      <h2 id="earth-title" class={paneTitle}>Tierra</h2>
    </section>

    <!-- Planeta elegido -->
    <section id="planet-pane" class="relative flex flex-col items-center justify-center gap-5 bg-deep p-4">
      <div id="planet-picker" class="z-20 flex flex-col items-center gap-3 transition-all duration-500">
        <p id="planet-picker-label" class="font-display text-xl text-mist md:text-2xl">Selecciona un planeta</p>
        <label for="planet-select" class="sr-only">Planeta</label>
        <select id="planet-select" class="field-select planet-select-ui !w-auto min-w-[14rem] px-5 py-3 text-lg md:min-w-[18rem] md:text-xl">
          <option value="">Elegir planeta…</option>
          {PLANETS.map((p) => <option value={p.id}>{p.name}</option>)}
        </select>
      </div>

      <p id="empty-prompt" class="max-w-xs text-center text-lg leading-snug text-mist">
        Elige la Luna o Marte para compararlos con la Tierra.
      </p>

      {
        PLANETS.map((p) => (
          <div data-planet-view={p.id} hidden class="flex flex-col items-center gap-5">
            <div class="planet-visual flex flex-col items-center gap-3">
              <Planet body={p.id} />
              <img data-zone-compare={p.id} alt="" hidden referrerpolicy="no-referrer" class="aspect-video w-[min(34vmin,26rem)] rounded-lg border border-line object-cover shadow-2xl" />
              <p data-zone-caption={p.id} hidden class="max-w-xs text-center text-sm text-mist"></p>
            </div>
            <h2 class={paneTitle}>{p.name}</h2>
          </div>
        ))
      }
    </section>

    <!-- Porcentaje y botón de búsqueda -->
    <div id="control" class="absolute bottom-5 left-1/2 z-40 flex -translate-x-1/2 flex-col items-center gap-2">
      <div
        class="min-w-32 rounded-md border border-line bg-panel px-4 py-1.5 text-center"
        aria-live="polite"
      >
        <span class="block text-xs text-mist">Similitud</span>
        <strong id="percent-value" class="font-display text-2xl font-semibold text-ochre">—</strong>
      </div>
      <button
        id="toggle-search"
        type="button"
        disabled
        aria-expanded="false"
        aria-controls="search-panel"
        aria-label="Buscar por características"
        class="grid size-12 place-items-center rounded-md border border-line bg-panel text-chalk transition-colors enabled:hover:border-ochre disabled:opacity-40"
      >
        <svg
          id="chevron"
          class="transition-transform duration-300"
          width="22"
          height="22"
          viewBox="0 0 22 22"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m5 9 6-6 6 6"></path>
          <path d="m5 17 6-6 6 6"></path>
        </svg>
      </button>
      <button id="reopen-results" type="button" hidden class="rounded-md border border-line bg-panel px-3 py-1.5 text-sm hover:border-ochre">Ver resultados</button>
    </div>

    <!-- Búsqueda por campos -->
    <form
      id="search-panel"
      hidden
      class="absolute inset-0 z-30 overflow-y-auto bg-deep/95 px-4 pb-44 pt-6 backdrop-blur md:px-10"
    >
      <h2 class="mb-6 text-center font-display text-3xl font-medium">Buscar por características</h2>
      <div class="mx-auto grid max-w-4xl gap-8 md:grid-cols-2">
        <fieldset class="space-y-4" data-group="earth">
          <legend class="mb-4 font-display text-2xl text-jade">Tierra</legend>
          {
            EARTH_FIELDS.map((f) => (
              <div>
                <label for={`earth-${f.id}`} class="mb-1.5 block text-sm text-mist">{f.label}</label>
                <select id={`earth-${f.id}`} name={f.id} class="field-select">
                  <option value="">Cualquiera</option>
                  {f.options.map((o) => <option value={o.value}>{o.label}</option>)}
                </select>
              </div>
            ))
          }
          <div class="mt-6 border-t border-line pt-4">
            <p class="mb-3 text-sm font-medium text-chalk">Punto geográfico y rango (opcional)</p>
            <div class="mb-3 flex flex-wrap items-center gap-2">
              <button id="use-my-location" type="button" class="rounded-md border border-line px-3 py-1.5 text-sm hover:border-ochre">📍 Usar mi ubicación</button>
              <span id="user-loc-status" class="text-xs text-mist"></span>
            </div>
            <div id="loc-map" class="mb-3 h-72 w-full overflow-hidden rounded-md border border-line md:h-[26rem]" aria-label="Mapa para seleccionar punto en la Tierra"></div>
            <div class="grid gap-3 sm:grid-cols-3">
              <div>
                <label for="loc-lat" class="mb-1.5 block text-sm text-mist">Latitud</label>
                <input id="loc-lat" name="loc-lat" type="number" step="any" min="-90" max="90" placeholder="ej. -24.5" class="field-select" />
              </div>
              <div>
                <label for="loc-lng" class="mb-1.5 block text-sm text-mist">Longitud</label>
                <input id="loc-lng" name="loc-lng" type="number" step="any" min="-180" max="180" placeholder="ej. -69.25" class="field-select" />
              </div>
              <div>
                <label for="loc-radius" class="mb-1.5 block text-sm text-mist">Radio</label>
                <select id="loc-radius" name="loc-radius" class="field-select">
                  <option value="">Sin filtro</option>
                  <option value="1">1 km</option>
                  <option value="10">10 km</option>
                  <option value="50">50 km</option>
                  <option value="100">100 km</option>
                </select>
              </div>
            </div>
            <p class="mt-2 text-xs text-mist">Haz clic en el mapa para elegir un punto de búsqueda y un radio. Si usas tu ubicación, se calcula ruta/accesibilidad desde ahí (OpenStreetMap/OSRM), se evita sugerir sitios justo a tu lado y se priorizan áreas más aisladas (menor interferencia humana) con nombre de lugar cuando está disponible.</p>
          </div>
        </fieldset>

        {
          PLANETS.map((p) => (
            <fieldset hidden class="space-y-4" data-group="zone" data-planet-fields={p.id}>
              <legend class:list={['mb-4 font-display text-2xl', p.id === 'marte' ? 'text-rust' : 'text-mist']}>
                {p.name}
              </legend>
              {p.fields.map((f) => (
                <div>
                  <label for={`${p.id}-${f.id}`} class="mb-1.5 block text-sm text-mist">{f.label}</label>
                  <select id={`${p.id}-${f.id}`} name={f.id} class="field-select">
                    <option value="">Cualquiera</option>
                    {f.options.map((o) => <option value={o.value}>{o.label}</option>)}
                  </select>
                </div>
              ))}
            </fieldset>
          ))
        }
      </div>
      <div class="mx-auto mt-8 flex max-w-4xl flex-col items-end gap-3">
        <button
          id="confirm"
          type="submit"
          class="rounded-md bg-jade px-6 py-2.5 font-semibold text-deep transition-colors hover:bg-[#63c498] disabled:opacity-60"
        >
          Confirmar
        </button>
        <div id="search-loading" hidden class="loading-overlay" role="status" aria-live="polite" aria-label="Buscando zonas similares">
          <div class="loading-popup">
            <div class="mb-3 flex items-center justify-center gap-3 text-xl font-semibold text-fog">
              <span class="inline-block size-8 animate-spin rounded-full border-[3px] border-ochre border-t-transparent" aria-hidden="true"></span>
              Buscando zonas similares…
            </div>
            <p class="mb-4 text-center text-sm text-mist">Consultando fuentes y calculando candidatos</p>
            <div class="mb-4 h-3 w-full overflow-hidden rounded-full bg-line/60">
              <div id="search-loading-bar" class="loading-bar h-full rounded-full bg-ochre" style="width:35%"></div>
            </div>
            <div id="search-loading-pct" class="mb-4 text-center text-sm font-medium text-ochre">Calculando…</div>
            <div class="grid gap-2">
              <div class="skeleton h-3 w-11/12 rounded"></div>
              <div class="skeleton h-3 w-full rounded"></div>
              <div class="skeleton h-3 w-10/12 rounded"></div>
              <div class="skeleton h-3 w-9/12 rounded"></div>
            </div>
          </div>
        </div>
        <p id="search-status" role="status" class="min-h-5 text-sm text-mist"></p>
      </div>
    </form>

    <!-- Resultados -->
    <section
      id="results"
      hidden
      aria-labelledby="results-title"
      class="absolute inset-0 z-30 overflow-y-auto bg-deep"
    >
      <div class="sticky top-0 z-10 border-b border-line bg-panel/95 px-4 py-3 backdrop-blur md:px-8">
        <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-4 gap-y-3">
          <button
            id="results-close"
            type="button"
            class="rounded-md border border-line px-3 py-1.5 text-sm hover:border-ochre"
          >
            Volver
          </button>
          <h2 id="results-title" class="font-display text-2xl font-medium">Zonas similares</h2>
          <div class="flex items-center gap-2">
            <button id="match-prev" type="button" aria-label="Zona anterior" class="grid size-9 place-items-center rounded-md border border-line text-lg hover:border-ochre disabled:opacity-40">‹</button>
            <button id="match-next" type="button" aria-label="Zona siguiente" class="grid size-9 place-items-center rounded-md border border-line text-lg hover:border-ochre disabled:opacity-40">›</button>
          </div>
          <div id="match-tabs" role="tablist" aria-label="Zonas encontradas" class="flex flex-wrap gap-2"></div>
          <div class="ml-auto flex flex-wrap gap-2">
            <button id="export-csv" type="button" class="rounded-md border border-line px-3 py-1.5 text-sm hover:border-ochre">Exportar CSV</button>
            <button id="export-pdf" type="button" class="rounded-md border border-line px-3 py-1.5 text-sm hover:border-ochre">Exportar PDF</button>
          </div>
        </div>
      </div>

      <div id="results-print-root" class="mx-auto max-w-6xl px-4 py-8 md:px-8">
        <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
          <p class="flex items-baseline gap-3">
            <span class="text-sm text-mist">Similitud</span>
            <strong id="result-percent" class="font-display text-5xl font-semibold text-ochre"></strong>
          </p>
          <label class="flex flex-col gap-1 text-sm">
            <span class="text-mist">Vista de datos</span>
            <select id="data-view" class="field-select min-w-[14rem] py-2 text-sm">
              <option value="both">Ambas (Tierra y zona)</option>
              <option value="earth">Solo Tierra</option>
              <option value="zone">Solo Luna/Marte</option>
            </select>
          </label>
        </div>
        <div id="results-skeleton" hidden class="grid gap-8 md:grid-cols-2" aria-hidden="true">
          <div class="space-y-3">
            <div class="skeleton h-8 w-2/3 rounded"></div>
            <div class="skeleton aspect-video w-full rounded-lg"></div>
            <div class="skeleton h-20 w-full rounded"></div>
            <div class="skeleton h-20 w-full rounded"></div>
            <div class="skeleton h-20 w-11/12 rounded"></div>
          </div>
          <div class="space-y-3">
            <div class="skeleton h-8 w-2/3 rounded"></div>
            <div class="skeleton aspect-video w-full rounded-lg"></div>
            <div class="skeleton h-20 w-full rounded"></div>
            <div class="skeleton h-20 w-full rounded"></div>
            <div class="skeleton h-20 w-11/12 rounded"></div>
          </div>
        </div>
        <section aria-labelledby="info-basic-title" class="info-section info-section-basic">
          <div class="mb-4 flex flex-wrap items-center gap-3">
            <h3 id="info-basic-title" class="font-display text-xl font-semibold">Información general</h3>
            <span class="info-badge info-badge-basic">Sencilla</span>
            <span class="text-sm text-mist">Resumen clave y correlación por campo</span>
          </div>
          <div id="general" class="grid gap-8 md:grid-cols-2"></div>
        </section>

        <section id="advanced-panel" aria-labelledby="info-advanced-title" class="info-section info-section-advanced mt-10">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div class="flex flex-wrap items-center gap-3">
              <h3 id="info-advanced-title" class="font-display text-xl font-semibold">Información avanzada</h3>
              <span class="info-badge info-badge-advanced">Avanzada</span>
              <span class="text-sm text-mist">Detalle técnico, fuentes, metodología y fórmulas</span>
            </div>
            <button
              id="advanced-toggle"
              type="button"
              aria-expanded="false"
              aria-controls="advanced"
              class="rounded-md border border-line bg-panel px-4 py-2 text-sm font-medium hover:border-ochre"
            >
              Mostrar información avanzada
            </button>
          </div>
          <p class="mt-2 text-sm text-mist">Incluye descripciones extendidas, parámetros/fórmulas y trazabilidad de datos (APIs o valores calculados/locales).</p>
          <div id="advanced" hidden class="mt-6 grid gap-8 md:grid-cols-2"></div>
        </section>
      </div>
    </section>
  </div>
      </div>
    </section>
  </main>

  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <script>
    import '../scripts/explorer';
  </script>
  <script>
    // reveal on scroll
    const els = document.querySelectorAll('.reveal');
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); } });
      }, { threshold: 0.12 });
      els.forEach((el) => { if (!el.classList.contains('is-visible')) io.observe(el); });
    } else {
      els.forEach((el) => el.classList.add('is-visible'));
    }
  </script>
</Base>
