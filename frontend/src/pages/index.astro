---
import Base from '../layouts/Base.astro';
import HomeView from '../components/home/HomeView.astro';
import ContentView from '../components/home/ContentView.astro';
import ExplorerView from '../components/explorer/ExplorerView.astro';
---

<Base title="Itzamná - Explorar análogos terrestres" transparentHeader={true}>
  <main id="app-views" class="app-view-root" data-view="home">
    <HomeView />
    <ContentView />
    <ExplorerView />
  </main>

  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

  <script>
    import '../scripts/explorer';
    import '../scripts/appViews';
    import '../scripts/reveal';
    import '../scripts/customDropdowns';
    import '../scripts/planetDropdown';
  </script>
</Base>
  </main>

  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
