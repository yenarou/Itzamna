              <button type="button" data-view-btn="earth" class="view-toggle-btn" aria-pressed="false">Solo Tierra</button>
              <button type="button" data-view-btn="zone" class="view-toggle-btn is-active" aria-pressed="true">Solo Luna/Marte</button>
