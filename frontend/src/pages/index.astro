  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <script>
    import '../scripts/explorer';
  </script>
  <script>
    // reveal on scroll
    const els = document.querySelectorAll('.reveal');
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); } });
      }, { threshold: 0.12 });
      els.forEach((el) => { if (!el.classList.contains('is-visible')) io.observe(el); });
    } else {
      els.forEach((el) => el.classList.add('is-visible'));
    }

    // View + content stepper navigation (no total scroll / por partes)
    (() => {
      const root = document.getElementById('app-views');
      if (!root) return;
      const views = Array.from(root.querySelectorAll<HTMLElement>('[data-app-view]'));
      const steps = Array.from(document.querySelectorAll<HTMLElement>('[data-content-step]')).sort((a,b)=>Number(a.dataset.contentStep)-Number(b.dataset.contentStep));
      const stepLabel = document.getElementById('content-step-label');
      const toExploreBtn = document.getElementById('content-to-explore');
      let stepIndex = 0;

      function showView(name: string, opts?: {focusPicker?: boolean}) {
        root!.dataset.view = name;
        views.forEach(v => { v.hidden = v.dataset.appView !== name; });
        if (name === 'content') {
          updateSteps();
          window.scrollTo({ top: 0, behavior: 'auto' });
        } else if (name === 'home') {
          window.scrollTo({ top: 0, behavior: 'auto' });
        } else if (name === 'explore') {
          window.scrollTo({ top: 0, behavior: 'auto' });
          if (opts?.focusPicker) {
            setTimeout(() => {
              document.getElementById('planet-picker')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
              (document.getElementById('planet-dd-trigger') as HTMLElement | null)?.focus?.();
            }, 50);
          }
        }
      }
      function updateSteps() {
        steps.forEach((s,i) => { s.hidden = i !== stepIndex; s.classList.toggle('is-active-step', i === stepIndex); });
        if (stepLabel) stepLabel.textContent = `${stepIndex + 1} / ${steps.length}`;
        if (toExploreBtn) toExploreBtn.hidden = stepIndex < steps.length - 1;
        const prevs = document.querySelectorAll<HTMLButtonElement>('[data-content-prev]');
        const nexts = document.querySelectorAll<HTMLButtonElement>('[data-content-next]');
        prevs.forEach(b => b.disabled = stepIndex <= 0);
        nexts.forEach(b => b.hidden = stepIndex >= steps.length - 1);
        window.scrollTo({ top: 0, behavior: 'auto' });
      }

      document.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        const viewBtn = t.closest<HTMLElement>('[data-show-view]');
        if (viewBtn) {
          e.preventDefault();
          showView(viewBtn.dataset.showView || 'home', { focusPicker: viewBtn.hasAttribute('data-focus-picker') });
          return;
        }
        if (t.closest('[data-content-next]')) { e.preventDefault(); if (stepIndex < steps.length - 1) { stepIndex++; updateSteps(); } return; }
        if (t.closest('[data-content-prev]')) { e.preventDefault(); if (stepIndex > 0) { stepIndex--; updateSteps(); } return; }
      });

      // default
      showView('home');
      updateSteps();
    })();

    // Custom dropdowns para selects de características (sync con selects ocultos)
    (() => {
      const initCustomDd = (dd: HTMLElement) => {
        const id = dd.dataset.ddFor;
        if (!id) return;
        const select = document.getElementById(id) as HTMLSelectElement | null;
        const trigger = dd.querySelector<HTMLElement>('[data-dd-trigger]');
        const label = dd.querySelector<HTMLElement>('[data-dd-label]');
        const menu = dd.querySelector<HTMLElement>('[data-dd-menu]');
        if (!select || !trigger || !label || !menu) return;
        const options = Array.from(menu.querySelectorAll<HTMLButtonElement>('[data-dd-option]'));

        const syncFromSelect = () => {
          const opt = select.options[select.selectedIndex] || select.options[0];
          label.textContent = opt ? (opt.textContent || 'Cualquiera') : 'Cualquiera';
          options.forEach(b => b.setAttribute('aria-selected', b.dataset.value === select.value ? 'true' : 'false'));
        };
        const setOpen = (open: boolean) => {
          dd.dataset.open = open ? 'true' : 'false';
          trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
          if (open) menu.removeAttribute('hidden'); else menu.setAttribute('hidden', '');
        };
        trigger.addEventListener('click', (e) => {
          e.preventDefault();
          const willOpen = dd.dataset.open !== 'true';
          document.querySelectorAll<HTMLElement>('.custom-dd[data-open="true"], .planet-dd[data-open="true"]').forEach(other => {
            if (other === dd) return;
            other.dataset.open = 'false';
            const t = other.querySelector<HTMLElement>('[aria-expanded="true"]');
            if (t) t.setAttribute('aria-expanded', 'false');
            other.querySelector<HTMLElement>('.custom-dd-menu, .planet-dd-menu')?.setAttribute('hidden', '');
          });
          setOpen(willOpen);
        });
        options.forEach(btn => btn.addEventListener('click', () => {
          const val = btn.dataset.value || '';
          select.value = val;
          select.dispatchEvent(new Event('change', { bubbles: true }));
          syncFromSelect();
          setOpen(false);
          trigger.focus();
        }));
        select.addEventListener('change', syncFromSelect);
        document.addEventListener('click', (e) => { if (!dd.contains(e.target as Node)) setOpen(false); });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
        syncFromSelect();
      };
      document.querySelectorAll<HTMLElement>('.custom-dd[data-dd-for]').forEach(initCustomDd);
    })();

    // Custom planet dropdown (syncs with hidden #planet-select for compatibility)
    (() => {
      const selectEl = document.getElementById('planet-select') as HTMLSelectElement | null;
      const ddEl = document.getElementById('planet-dd') as HTMLElement | null;
      const triggerEl = document.getElementById('planet-dd-trigger') as HTMLButtonElement | null;
      const labelEl = document.getElementById('planet-dd-label') as HTMLElement | null;
      const menuEl = document.getElementById('planet-dd-menu') as HTMLElement | null;
      if (!selectEl || !ddEl || !triggerEl || !labelEl || !menuEl) return;
      const select = selectEl, dd = ddEl, trigger = triggerEl, label = labelEl, menu = menuEl;

      const options = Array.from(menu.querySelectorAll<HTMLButtonElement>('.planet-dd-option'));
      function syncFromSelect() {
        const opt = select.options[select.selectedIndex] || select.options[0];
        label.textContent = opt ? (opt.textContent || 'Elegir planeta…') : 'Elegir planeta…';
        options.forEach(b => b.setAttribute('aria-selected', b.dataset.value === select.value ? 'true' : 'false'));
      }
      function setOpen(open: boolean) {
        dd.dataset.open = open ? 'true' : 'false';
        trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
        if (open) menu.removeAttribute('hidden'); else menu.setAttribute('hidden', '');
      }
      trigger.addEventListener('click', (e) => { e.preventDefault(); setOpen(dd.dataset.open !== 'true'); });
      options.forEach(btn => btn.addEventListener('click', () => {
        const val = btn.dataset.value || '';
        select.value = val;
        select.dispatchEvent(new Event('change', { bubbles: true }));
        syncFromSelect();
        setOpen(false);
        trigger.focus();
      }));
      select.addEventListener('change', syncFromSelect);
      document.addEventListener('click', (e) => { if (!dd.contains(e.target as Node)) setOpen(false); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
      syncFromSelect();
    })();
  </script>
