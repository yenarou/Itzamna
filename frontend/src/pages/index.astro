---
import Base from '../layouts/Base.astro';
import Planet from '../components/Planet.astro';
import { EARTH_FIELDS, PLANETS } from '../lib/data';

const paneTitle = 'font-display text-3xl font-medium';
const tech = [
  { name: 'Astro', desc: 'Framework del frontend para páginas rápidas y contenido estático optimizado.' },
  { name: 'TypeScript', desc: 'Tipado en el frontend y scripts para mayor claridad y mantenimiento.' },
  { name: 'Tailwind CSS', desc: 'Sistema de estilos utilitario para la interfaz y el diseño responsive.' },
  { name: 'ASP.NET Core', desc: 'Backend que expone y orquesta la API de búsqueda de análogos.' },
  { name: 'Python', desc: 'Lenguaje del motor científico para cálculo e integración de datos.' },
  { name: 'FastAPI', desc: 'Servicio científico que procesa consultas y devuelve candidatos/análisis.' },
];
---

<Base title="Explorar" transparentHeader>
  <main class="page-wrap" id="app-views" data-view="home">
    <!-- VIEW: HOME (pantalla principal) -->
    <section id="view-home" class="app-view" data-app-view="home" aria-labelledby="hero-title">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-stars" aria-hidden="true"></div>
        <div class="hero-orbits" aria-hidden="true">
          <span class="hero-orbit o1"></span>
          <span class="hero-orbit o2"></span>
          <span class="hero-orbit o3"></span>
          <span class="hero-planet mars"></span>
          <span class="hero-planet moon"></span>
        </div>
        <div class="hero-glow" aria-hidden="true"></div>
        <div class="hero-content reveal is-visible">
          <p class="hero-kicker">Exploración científica · Análogos terrestres</p>
          <h1 id="hero-title">Explorando la Tierra para comprender otros mundos.</h1>
          <p>
            Itzamná identifica regiones terrestres con características comparables a entornos de la Luna y Marte mediante análisis geoespacial y criterios científicos.
          </p>
          <div class="hero-actions">
            <button type="button" class="btn-primary" data-show-view="explore" data-focus-picker="true">Explorar Itzamná</button>
          </div>
        </div>
      </section>
    </section>

    <!-- VIEW: CONTENT (por partes, sin scroll total) -->
    <section id="view-content" class="app-view" data-app-view="content" hidden aria-label="Contenido del proyecto">
      <div class="content-shell">
        <div class="content-topbar">
          <div class="content-progress" aria-live="polite"><span id="content-step-label">1 / 6</span></div>
        </div>

        <!-- Hero dentro de contenido -->
        <section class="content-hero reveal is-visible" data-content-step="0">
          <div class="content-hero-inner">
            <p class="hero-kicker">Itzamná · Misión y contexto</p>
            <h2>De la superficie terrestre a la exploración planetaria</h2>
            <p>Conoce el propósito, análisis y tecnología detrás de la plataforma en secciones breves, una a la vez.</p>
            <div class="hero-actions">
              <button type="button" class="btn-primary" data-content-next>Siguiente</button>
              <button type="button" class="btn-secondary" data-show-view="explore" data-focus-picker="true">Explorar ahora</button>
            </div>
          </div>
        </section>

        <div id="content-parts">
    <!-- ZIGZAG 1: ¿Qué es Itzamná? -->
    <section class="zigzag" id="que-es" data-content-step="1">
      <div class="zigzag-inner">
        <div class="zigzag-media reveal is-visible">
          <img src="https://images-assets.nasa.gov/image/PIA18033/PIA18033~orig.jpg" alt="La Tierra vista desde el espacio, con océanos y continentes iluminados" loading="lazy" decoding="async" />
        </div>
        <div class="zigzag-copy reveal is-visible">
          <p class="zigzag-kicker">Plataforma</p>
          <h2>¿Qué es Itzamná?</h2>
          <p>
            <strong>Itzamná (Integrated Terrestrial-Zonal Analog &amp; Multi-factor Nearest Atlas)</strong> es una plataforma que ayuda a localizar y comparar regiones de la Tierra con rasgos similares a zonas de la Luna y Marte.
          </p>
          <p>
            A partir de un punto geográfico, un radio y características seleccionadas, calcula candidatos análogos y presenta información georreferenciada, similitud por criterios y datos de apoyo para la exploración y el análisis.
          </p>
        </div>
      </div>
    </section>

    <!-- ZIGZAG 2: Nuestro propósito -->
    <section class="zigzag zigzag-alt" id="proposito" data-content-step="2" hidden>
      <div class="zigzag-inner reverse">
        <div class="zigzag-media reveal is-visible">
          <img src="https://images-assets.nasa.gov/image/PIA17944/PIA17944~orig.jpg" alt="Superficie de Marte en el cráter Gale, vista por el rover Curiosity" loading="lazy" decoding="async" />
        </div>
        <div class="zigzag-copy reveal is-visible">
          <p class="zigzag-kicker">Propósito</p>
          <h2>Nuestro propósito</h2>
          <p>
            Encontrar análogos terrestres permite estudiar, en nuestro propio planeta, condiciones y paisajes comparables a entornos extraterrestres. Esto facilita preparar observaciones, entrenamientos y análisis en lugares accesibles antes de pensar en escenarios lunares o marcianos.
          </p>
          <p>
            Itzamná busca hacer esa comparación más clara: reunir ubicación, contexto ambiental y criterios de similitud en una sola vista para apoyar la toma de decisiones y el aprendizaje.
          </p>
        </div>
      </div>
    </section>

    <!-- ZIGZAG 3: Exploración y análisis -->
    <section class="zigzag" id="analisis" data-content-step="3" hidden>
      <div class="zigzag-inner">
        <div class="zigzag-media reveal is-visible">
          <img src="https://images-assets.nasa.gov/image/PIA00256/PIA00256~orig.jpg" alt="Superficie lunar con cráteres y mares basálticos" loading="lazy" decoding="async" />
        </div>
        <div class="zigzag-copy reveal is-visible">
          <p class="zigzag-kicker">Análisis geoespacial</p>
          <h2>Exploración y análisis</h2>
          <p>
            La plataforma permite seleccionar un planeta y una zona de interés, elegir un punto en el mapa y definir un radio de búsqueda. Con esos parámetros genera candidatos calculados en el área y muestra su similitud, distancia y correlación por campo.
          </p>
          <p>
            Los resultados combinan datos de consulta (cuando las fuentes responden) con estimaciones locales marcadas como tales, ofreciendo una lectura transparente entre datos obtenidos y valores calculados.
          </p>
        </div>
      </div>
    </section>

    <!-- ZIGZAG 4: Tecnología -->
    <section class="zigzag zigzag-alt" id="tecnologia" data-content-step="4" hidden>
      <div class="zigzag-inner reverse">
        <div class="zigzag-media reveal is-visible">
          <img src="https://images-assets.nasa.gov/image/PIA12235/PIA12235~orig.jpg" alt="Mapa topográfico y relieve representando análisis de superficie" loading="lazy" decoding="async" />
        </div>
        <div class="zigzag-copy reveal is-visible">
          <p class="zigzag-kicker">Arquitectura</p>
          <h2>Tecnología</h2>
          <p>Itzamná integra componentes web y de cálculo científico, cada uno con una responsabilidad definida:</p>
          <ul>
            {tech.map((t) => (
              <li><strong>{t.name}:</strong> {t.desc}</li>
            ))}
          </ul>
          <div class="chip-row" aria-label="Tecnologías del proyecto">
            {tech.map((t) => <span class="chip">{t.name}</span>)}
          </div>
        </div>
      </div>
    </section>

    <!-- ZIGZAG 5: Visión a futuro -->
    <section class="zigzag" id="vision-futuro" data-content-step="5" hidden>
      <div class="zigzag-inner">
        <div class="zigzag-media reveal is-visible">
          <img src="https://images-assets.nasa.gov/image/PIA03654/PIA03654~orig.jpg" alt="Concepto de exploración planetaria y terreno rocoso" loading="lazy" decoding="async" />
        </div>
        <div class="zigzag-copy reveal is-visible">
          <p class="zigzag-kicker">Evolución</p>
          <h2>Visión a futuro</h2>
          <p>
            La visión del proyecto es fortalecer la precisión y utilidad de las comparaciones, incorporando de forma progresiva mejores fuentes de datos y criterios de análisis documentados, para que la herramienta sea cada vez más útil en contextos educativos y de planificación exploratoria.
          </p>
          <p>
            Cualquier nueva capacidad se incorporará de manera gradual y verificable, manteniendo clara la distinción entre resultados calculados, estimaciones y datos provenientes de fuentes externas.
          </p>
        </div>
      </div>
    </section>
        </div>

        <div class="content-nav">
          <button type="button" class="btn-secondary" data-content-prev>Anterior</button>
          <button type="button" class="btn-primary" data-content-next>Siguiente</button>
          <button type="button" class="btn-primary" id="content-to-explore" hidden data-show-view="explore" data-focus-picker="true">Ir al explorador</button>
        </div>
      </div>
    </section>

    <!-- VIEW: EXPLORE (herramienta, funcionalidad preservada) -->
    <section id="view-explore" class="app-view" data-app-view="explore" hidden aria-label="Explorador de análogos">

      <section id="explorador" class="relative" aria-label="Explorador de análogos">
        <div class="mx-auto max-w-7xl px-4 pt-4 pb-4 md:px-8">
          <p class="zigzag-kicker">Herramienta</p>
          <h2 class="font-display text-3xl font-semibold tracking-tight md:text-4xl">Explorar análogos terrestres</h2>
          <p class="mt-3 max-w-2xl text-mist">Selecciona un planeta, define características y un punto en la Tierra para buscar zonas comparables.</p>
        </div>

        <div class="mx-auto max-w-[110rem] px-2 pb-6 md:px-4">
  <div
    id="explorer"
    data-state="idle"
    class="relative grid min-h-[88svh] grid-rows-2 overflow-hidden rounded-2xl md:grid-cols-2 md:grid-rows-1"
  >
    <!-- Tierra -->
    <section
      aria-labelledby="earth-title"
      class="flex flex-col items-center justify-center gap-5 bg-[#10303e] p-4"
    >
      <div id="earth-visual" class="flex flex-col items-center gap-3">
        <Planet body="tierra" />
        <div id="earth-compare-wrap" class="relative hidden w-full max-w-[min(38vmin,28rem)]">
          <img id="earth-compare" alt="" hidden referrerpolicy="no-referrer" class="aspect-video w-full rounded-xl border border-line/60 object-cover shadow-2xl" />
          <span aria-hidden="true" class="pointer-events-none absolute left-1/2 top-1/2 z-10 -translate-x-1/2 -translate-y-full"><span class="block h-4 w-4 -rotate-45 rounded-full rounded-bl-none border-2 border-white bg-ochre shadow-lg"></span><span class="mx-auto -mt-0.5 block h-2 w-2 rounded-full bg-white/90 shadow"></span></span>
        </div>
        <p id="earth-compare-caption" hidden class="max-w-[min(38vmin,28rem)] text-center text-sm leading-relaxed text-mist"></p>
      </div>
      <h2 id="earth-title" class={paneTitle}>Tierra</h2>
    </section>

    <!-- Planeta elegido -->
    <section id="planet-pane" class="relative flex flex-col items-center justify-center gap-5 bg-deep p-4">
      <div id="planet-picker" class="z-20 flex flex-col items-center gap-3 transition-all duration-500">
        <p id="planet-picker-label" class="font-display text-xl text-mist md:text-2xl">Selecciona un planeta</p>
        <label for="planet-select" class="sr-only">Planeta</label>
        <select id="planet-select" class="sr-only" aria-hidden="true" tabindex="-1">
          <option value="">Elegir planeta…</option>
          {PLANETS.map((p) => <option value={p.id}>{p.name}</option>)}
        </select>
        <div class="planet-dd" id="planet-dd" data-open="false">
          <button type="button" id="planet-dd-trigger" class="planet-dd-trigger" aria-haspopup="listbox" aria-expanded="false">
            <span id="planet-dd-label">Elegir planeta…</span>
            <svg aria-hidden="true" viewBox="0 0 20 20" class="planet-dd-caret"><path d="M5 7l5 6 5-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <ul id="planet-dd-menu" class="planet-dd-menu" role="listbox" aria-label="Planeta" hidden>
            <li><button type="button" class="planet-dd-option" role="option" data-value="">Elegir planeta…</button></li>
            {PLANETS.map((p) => <li><button type="button" class="planet-dd-option" role="option" data-value={p.id}>{p.name}</button></li>)}
          </ul>
        </div>
      </div>

      <p id="empty-prompt" class="max-w-xs text-center text-lg leading-snug text-mist">
        Elige la Luna o Marte para compararlos con la Tierra.
      </p>

      {
        PLANETS.map((p) => (
          <div data-planet-view={p.id} hidden class="flex flex-col items-center gap-5">
            <div class="planet-visual flex w-full flex-col items-center gap-3">
              <Planet body={p.id} />
              <img data-zone-compare={p.id} alt="" hidden referrerpolicy="no-referrer" class="aspect-video w-full max-w-[min(38vmin,28rem)] rounded-xl border border-line/60 object-cover shadow-2xl" />
              <p data-zone-caption={p.id} hidden class="max-w-[min(38vmin,28rem)] text-center text-sm leading-relaxed text-mist"></p>
            </div>
            <h2 class={paneTitle}>{p.name}</h2>
          </div>
        ))
      }
    </section>

    <!-- Porcentaje y botón de búsqueda -->
    <div id="control" class="absolute bottom-5 left-1/2 z-40 flex -translate-x-1/2 flex-col items-center gap-2">
      <div
        class="min-w-32 rounded-md border border-line bg-panel px-4 py-1.5 text-center"
        aria-live="polite"
      >
        <span class="block text-xs text-mist">Similitud</span>
        <strong id="percent-value" class="font-display text-2xl font-semibold text-ochre">—</strong>
      </div>
      <button
        id="toggle-search"
        type="button"
        disabled
        aria-expanded="false"
        aria-controls="search-panel"
        aria-label="Buscar por características"
        class="grid size-12 place-items-center rounded-md border border-line bg-panel text-chalk transition-colors enabled:hover:border-ochre disabled:opacity-40"
      >
        <svg
          id="chevron"
          class="transition-transform duration-300"
          width="22"
          height="22"
          viewBox="0 0 22 22"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m5 9 6-6 6 6"></path>
          <path d="m5 17 6-6 6 6"></path>
        </svg>
      </button>
      <button id="reopen-results" type="button" hidden class="rounded-md border border-line bg-panel px-3 py-1.5 text-sm hover:border-ochre">Ver resultados</button>
    </div>

    <!-- Búsqueda por campos -->
    <form
      id="search-panel"
      hidden
      class="absolute inset-0 z-30 overflow-y-auto px-4 pb-44 pt-6 md:px-10"
    >
      <h2 class="mb-6 text-center font-display text-3xl font-medium">Buscar por características</h2>
      <div class="mx-auto grid w-full max-w-6xl gap-8 md:grid-cols-2">
        <fieldset class="space-y-4" data-group="earth">
          <legend class="mb-4 font-display text-2xl text-jade">Tierra</legend>
          {
            EARTH_FIELDS.map((f) => (
              <div>
                <label for={`earth-${f.id}`} class="mb-1.5 block text-sm text-mist">{f.label}</label>
                <select id={`earth-${f.id}`} name={f.id} class="field-select sr-only" aria-hidden="true" tabindex="-1">
                  <option value="">Cualquiera</option>
                  {f.options.map((o) => <option value={o.value}>{o.label}</option>)}
                </select>
                <div class="custom-dd" data-dd-for={`earth-${f.id}`} data-open="false">
                  <button type="button" class="custom-dd-trigger" data-dd-trigger={`earth-${f.id}`} aria-haspopup="listbox" aria-expanded="false">
                    <span data-dd-label={`earth-${f.id}`}>Cualquiera</span>
                    <svg aria-hidden="true" viewBox="0 0 20 20" class="custom-dd-caret"><path d="M5 7l5 6 5-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </button>
                  <ul class="custom-dd-menu" data-dd-menu={`earth-${f.id}`} role="listbox" aria-label={f.label} hidden>
                    <li><button type="button" class="custom-dd-option" role="option" data-dd-option data-value="">Cualquiera</button></li>
                    {f.options.map((o) => <li><button type="button" class="custom-dd-option" role="option" data-dd-option data-value={o.value}>{o.label}</button></li>)}
                  </ul>
                </div>
              </div>
            ))
          }
        </fieldset>

        {
          PLANETS.map((p) => (
            <fieldset hidden class="space-y-4" data-group="zone" data-planet-fields={p.id}>
              <legend class:list={['mb-4 font-display text-2xl', p.id === 'marte' ? 'text-rust' : 'text-mist']}>
                {p.name}
              </legend>
              {p.fields.map((f) => (
                <div>
                  <label for={`${p.id}-${f.id}`} class="mb-1.5 block text-sm text-mist">{f.label}</label>
                  <select id={`${p.id}-${f.id}`} name={f.id} class="field-select sr-only" aria-hidden="true" tabindex="-1">
                    <option value="">Cualquiera</option>
                    {f.options.map((o) => <option value={o.value}>{o.label}</option>)}
                  </select>
                  <div class="custom-dd" data-dd-for={`${p.id}-${f.id}`} data-open="false">
                    <button type="button" class="custom-dd-trigger" data-dd-trigger={`${p.id}-${f.id}`} aria-haspopup="listbox" aria-expanded="false">
                      <span data-dd-label={`${p.id}-${f.id}`}>Cualquiera</span>
                      <svg aria-hidden="true" viewBox="0 0 20 20" class="custom-dd-caret"><path d="M5 7l5 6 5-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                    <ul class="custom-dd-menu" data-dd-menu={`${p.id}-${f.id}`} role="listbox" aria-label={f.label} hidden>
                      <li><button type="button" class="custom-dd-option" role="option" data-dd-option data-value="">Cualquiera</button></li>
                      {f.options.map((o) => <li><button type="button" class="custom-dd-option" role="option" data-dd-option data-value={o.value}>{o.label}</button></li>)}
                    </ul>
                  </div>
                </div>
              ))}
            </fieldset>
          ))
        }

        <div class="md:col-span-2">
          <div class="loc-card">
            <div class="loc-card-header">
              <div>
                <p class="loc-card-kicker">Punto geográfico</p>
                <h3 class="loc-card-title">Ubicación y radio de búsqueda <span class="loc-optional">(opcional)</span></h3>
              </div>
              <button id="use-my-location" type="button" class="loc-action-btn" aria-label="Usar mi ubicación actual">
                <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 2v3m0 14v3M2 12h3m14 0h3"/><circle cx="12" cy="12" r="8" opacity=".45"/></svg>
                <span>Usar mi ubicación</span>
              </button>
            </div>
            <p id="user-loc-status" class="loc-status text-xs text-mist" aria-live="polite"></p>

            <div class="loc-map-wrap">
              <div id="loc-map" class="loc-map" aria-label="Mapa para seleccionar punto en la Tierra"></div>
              <div class="loc-map-hint" aria-hidden="true">
                <svg viewBox="0 0 20 20" class="size-4" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M10 2.5a5.5 5.5 0 0 0-5.5 5.5c0 4.1 5.5 9.5 5.5 9.5s5.5-5.4 5.5-9.5A5.5 5.5 0 0 0 10 2.5Z"/><circle cx="10" cy="8" r="1.8"/></svg>
                <span>Clic en el mapa para fijar el punto</span>
              </div>
            </div>

            <div class="loc-controls">
              <div>
                <label for="loc-lat" class="mb-1.5 block text-sm text-mist">Latitud</label>
                <input id="loc-lat" name="loc-lat" type="number" step="any" min="-90" max="90" placeholder="ej. -24.5" class="field-select" />
              </div>
              <div>
                <label for="loc-lng" class="mb-1.5 block text-sm text-mist">Longitud</label>
                <input id="loc-lng" name="loc-lng" type="number" step="any" min="-180" max="180" placeholder="ej. -69.25" class="field-select" />
              </div>
              <div>
                <label for="loc-radius" class="mb-1.5 block text-sm text-mist">Radio de búsqueda</label>
                <select id="loc-radius" name="loc-radius" class="field-select sr-only" aria-hidden="true" tabindex="-1">
                  <option value="">Sin filtro</option>
                  <option value="1">1 km</option>
                  <option value="10">10 km</option>
                  <option value="50">50 km</option>
                  <option value="100">100 km</option>
                </select>
                <div class="custom-dd" data-dd-for="loc-radius" data-open="false">
                  <button type="button" class="custom-dd-trigger" data-dd-trigger="loc-radius" aria-haspopup="listbox" aria-expanded="false">
                    <span data-dd-label="loc-radius">Sin filtro</span>
                    <svg aria-hidden="true" viewBox="0 0 20 20" class="custom-dd-caret"><path d="M5 7l5 6 5-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </button>
                  <ul class="custom-dd-menu" data-dd-menu="loc-radius" role="listbox" aria-label="Radio de búsqueda" hidden>
                    <li><button type="button" class="custom-dd-option" role="option" data-dd-option data-value="">Sin filtro</button></li>
                    <li><button type="button" class="custom-dd-option" role="option" data-dd-option data-value="1">1 km</button></li>
                    <li><button type="button" class="custom-dd-option" role="option" data-dd-option data-value="10">10 km</button></li>
                    <li><button type="button" class="custom-dd-option" role="option" data-dd-option data-value="50">50 km</button></li>
                    <li><button type="button" class="custom-dd-option" role="option" data-dd-option data-value="100">100 km</button></li>
                  </ul>
                </div>
              </div>
            </div>
            <p class="loc-help">Haz clic en el mapa para elegir un punto y ajusta el radio. Si usas tu ubicación, se calcula ruta/accesibilidad desde ahí (OpenStreetMap/OSRM) y se priorizan áreas con menor interferencia humana.</p>
            <div class="loc-confirm mt-4">
              <button
                id="confirm"
                type="submit"
                class="confirm-search-btn group w-full"
              >
                <span class="confirm-search-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="6.5"/><path d="m20 20-3.8-3.8"/></svg>
                </span>
                <span class="flex flex-col items-start leading-tight">
