---
interface Card {
  heading: string;
  paragraphs: string[];
}
interface Props {
  /** Fila superior: tarjeta de título (estrecha) + información (ancha). */
  topLabel: Card;
  topInfo: Card;
  /** Fila inferior: información (ancha) + tarjeta de título (estrecha). */
  bottomInfo: Card;
  bottomLabel: Card;
}
const { topLabel, topInfo, bottomInfo, bottomLabel } = Astro.props;
---

<main class="info-mosaic mx-auto grid w-full max-w-6xl flex-1 gap-4 p-4 md:grid-cols-12 md:p-8">
  <section class="info-mosaic__card md:col-span-4">
    <div class="info-mosaic__tag">Itzamná</div>
    <h1 class="info-mosaic__title info-mosaic__title--large">{topLabel.heading}</h1>
    {topLabel.paragraphs.map((p) => <p class="info-mosaic__text">{p}</p>)}
  </section>

  <section class="info-mosaic__card md:col-span-8">
    <h2 class="info-mosaic__title">{topInfo.heading}</h2>
    {topInfo.paragraphs.map((p) => <p class="info-mosaic__text">{p}</p>)}
  </section>

  <section class="info-mosaic__card md:col-span-8">
    <h2 class="info-mosaic__title">{bottomInfo.heading}</h2>
    {bottomInfo.paragraphs.map((p) => <p class="info-mosaic__text">{p}</p>)}
  </section>

  <section class="info-mosaic__card md:col-span-4">
    <h2 class="info-mosaic__title info-mosaic__title--large">{bottomLabel.heading}</h2>
    {bottomLabel.paragraphs.map((p) => <p class="info-mosaic__text">{p}</p>)}
  </section>
</main>
