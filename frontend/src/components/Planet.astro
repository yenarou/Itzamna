---
import { PLANET_IMAGES } from '../lib/data';

interface Props {
  body: 'tierra' | 'luna' | 'marte';
}

const { body } = Astro.props;

const src = PLANET_IMAGES[body];
---

<div class={`planet planet-${body}`} aria-hidden="true">
  <img src={src} alt="" loading="eager" />
</div>

<style>
  .planet {
    position: relative;
    width: min(34vmin, 26rem);
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.06), 0 30px 80px rgb(0 0 0 / 0.45);
    background: #111827;
  }

  .planet img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(1.05) contrast(1.08);
  }

  .planet::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(circle at 30% 26%, rgb(255 255 255 / 0.18), transparent 42%),
      radial-gradient(circle at 72% 78%, transparent 38%, rgb(0 0 0 / 0.55) 100%);
    pointer-events: none;
  }
</style>
