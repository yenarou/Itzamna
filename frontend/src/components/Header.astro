---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/', label: 'Explorar' },
  { href: '/vision', label: 'Visión' },
  { href: '/nosotros', label: 'Nosotros' },
];
---

<header class="flex h-16 shrink-0 items-center justify-between border-b border-line bg-panel/90 px-4 md:px-8">
  <div class="flex items-center gap-3">
    <a href="/" class="flex items-center gap-3 font-display text-[1.8rem] font-semibold tracking-[-0.06em] text-chalk">
      <span class="inline-flex h-10 w-10 items-center justify-center overflow-hidden rounded-[0.7rem] border border-[var(--logo-ring)] bg-[rgba(255,255,255,0.08)] shadow-[inset_1px_1px_0_rgba(255,255,255,0.24)]">
        <img src="/logo-itzamna.svg" alt="Itzamná" class="h-8 w-8 object-contain" />
      </span>
      <span>Itzamná</span>
    </a>
  </div>

  <div class="flex items-center gap-2">
    <button
      id="theme-toggle"
      type="button"
      aria-label="Cambiar tema"
      class="inline-flex h-9 w-9 items-center justify-center rounded-[0.55rem] border border-line bg-[rgba(255,255,255,0.04)] text-base text-chalk transition-colors hover:bg-[rgba(255,255,255,0.08)]"
    >
      <span aria-hidden="true">☀️</span>
    </button>

    <nav aria-label="Principal">
      <ul class="flex gap-1.5">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                aria-current={path === l.href ? 'page' : undefined}
                class:list={[
                  'px-3 py-1.5 text-sm font-medium transition-colors',
                  path === l.href
                    ? 'rounded-[0.5rem] border border-line bg-[rgba(255,255,255,0.08)] text-chalk shadow-[var(--shadow-inset)]'
                    : 'rounded-[0.5rem] text-mist hover:text-chalk',
                ]}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const root = document.documentElement;
  const btn = document.getElementById('theme-toggle');
  const savedTheme = localStorage.getItem('itzamna-theme');

  const applyTheme = (theme: 'light' | 'dark') => {
    const isLight = theme === 'light';
    root.setAttribute('data-theme', isLight ? 'light' : 'dark');
    if (btn) {
      btn.innerHTML = isLight ? '<span aria-hidden="true">🌙</span>' : '<span aria-hidden="true">☀️</span>';
      btn.setAttribute('aria-label', isLight ? 'Cambiar a tema oscuro' : 'Cambiar a tema claro');
    }
  };

  const preferred: 'light' | 'dark' = (savedTheme === 'light' || savedTheme === 'dark')
    ? savedTheme
    : window.matchMedia('(prefers-color-scheme: light)').matches
      ? 'light'
      : 'dark';
  applyTheme(preferred);

  btn?.addEventListener('click', () => {
    const current = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
    localStorage.setItem('itzamna-theme', current);
    applyTheme(current);
  });
</script>
